rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() ? request.auth.token.email : null;
    }

    function isAdminEmail() {
      return email() in ['resmag@local.pe', 'admin@resmag.local', 'logisticaymanteniendo@gmail.com'];
    }

    match /cotizaciones/{docId} {
      allow create: if true;
      allow read: if signedIn() && isAdminEmail();
      allow update, delete: if false;
    }

    match /usuarios/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
